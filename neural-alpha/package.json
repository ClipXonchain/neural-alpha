{
  "name": "@neural-alpha/agent",
  "version": "1.0.0",
  "description": "Neural Alpha — autonomous bStock agent (CMC + Binance Agentic Wallet)",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "tsx --import ./src/load-env.ts src/index.ts",
    "dev": "tsx watch --import ./src/load-env.ts src/index.ts",
    "register": "tsx src/register.ts",
    "test": "tsx --test src/integrations/campaign-x402-schedule.test.ts src/risk/manager.test.ts src/risk/portfolio-exits.test.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.0",
    "dotenv": "^16.4.7",
    "openai": "^6.44.0",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}
