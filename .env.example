# CoinMarketCap Pro API (optional sentiment / F&G)
# Get from: https://coinmarketcap.com/api/agent
CMC_PRO_API_KEY=

# ── Binance Agentic Wallet (`baw` CLI) ──
# Docs: https://web3.binance.com/en/dev-docs/products/agentic-wallet/introduction
# Install: npm i -g @binance/agentic-wallet
# Sign in: baw auth signin   then confirm in the Binance App
BAW_CLI=baw
BINANCE_CHAIN_ID=56

# Campaign payment token for buying bStock (must be one of BNB, USDT, USDC, U, USD1)
PAYMENT_TOKEN=USDT

# Set true AFTER you tap Join Now on the campaign page and bind this wallet
# CAMPAIGN_REGISTERED=true
# CAMPAIGN_JOIN_URL=https://web3.binance.com/en/campaigns/bstock-pnl-contest

# Optional: comma-separated current-week eligible bStocks (overrides data/eligible-bstocks.json)
# ELIGIBLE_BSTOCKS=NVDAB,AAPLB,TSLAB,SPYB
# ALLOW_LEVERAGED_BSTOCKS=false

# Agent wallet — usually auto-detected from `baw wallet address`
# AGENT_WALLET_ADDRESS=0x...
# Starting USDT/stable deposit. Total PnL = current NAV − (this + BNB gas at lock).
# Aliases: INITIAL_CASH_USD, AGENT_NAV_USD
INITIAL_DEPOSIT_USD=2000
AGENT_NAV_USD=2000

# Optional: x402 pay-per-request for CMC (USDC on Base, ~$0.01/request)
# X402_PRIVATE_KEY=
# X402_NETWORK=eip155:8453

# Default swap source tokens for buys (USDT first, then BNB). Sells settle to BASE_CURRENCY.
# SWAP_CURRENCIES=USDT,BNB
# BASE_CURRENCY=USDT
# MIN_GAS_RESERVE_USD=1.5
# MIN_POSITION_VALUE_USD=1

# Default swap source token for rebalance (legacy — prefer SWAP_CURRENCIES)
DEFAULT_FROM_SYMBOL=USDT

# Cycle interval in ms — full scan + autonomous buys (live default: 3600000 = 1h)
# Live default 5 min (paper 30s). Overnight/open gaps need a short cycle.
# TRADE_INTERVAL_MS=300000

# SL/TP/trailing check interval — sells only, independent of trade cycle (default 60s)
# PROTECTIVE_EXIT_CHECK_MS=60000

# MIN_TRADE_AMOUNT_USD=5

# x402 spend cap (wei) — optional, uses bnbagent budget module
# X402_SPEND_CAP_WEI=1000000

# ── Session policy (24/7 on-chain bStock) ──
# auto      = follow NY clock: RTH 9:30–16:00 → Close 16:00–20:00 → Overnight
# rth       = lock cash hours (trend + ORB, larger size)
# close     = lock overnight-premium harvest into 16:00 ET
# overnight = lock gaps + news, smaller size
# SESSION_POLICY=auto
# Legacy STRATEGY=safe|medium|momentum maps to overnight|auto|rth.

# Per-strategy risk defaults can be overridden explicitly:
# MAX_DRAWDOWN_PCT=20
# Disable drawdown gates and emergency mode entirely (autonomous buys never blocked by DD):
DISABLE_DRAWDOWN_LIMIT=true
# Live quote pulse (Binance Web3). Independent of the trade cycle. Default 10s.
# SIGNAL_REFRESH_MS=10000

# CMC campaign MCP overlay (get_global_metrics_latest + get_upcoming_macro_events).
# ~$0.01/call. Cached — do not lower these to the 10s quote pulse.
# CMC_MACRO_ENABLED=true
# CMC_MACRO_REFRESH_MS=2700000   # 45 min global tape (~$0.32/day)
# CMC_EVENTS_REFRESH_MS=21600000 # 6 h event calendar
#
# Paid campaign x402 — CMC MCP and Agent Studio independently.
# Both ON by default (needed for ≥3 CMC + ≥3 Studio campaign calls).
# When a portfolio slot is free (positionCount < MAX_PORTFOLIO_TOKENS), fire
# immediately (15s min cooldown). When slots are full, use these intervals.
# CMC_X402_ENABLED=true
# CMC_X402_INTERVAL_MS=2700000     # ms; falls back to CMC_MACRO_REFRESH_MS, else 4h
# STUDIO_X402_ENABLED=true
# STUDIO_X402_INTERVAL_MS=2700000  # ms; default 4h if unset
# Set CMC_X402_ENABLED=false or STUDIO_X402_ENABLED=false to skip that source.

# Skip tokens below this USD price + blocklisted tickers from scans and new buys
# MIN_TRADABLE_PRICE_USD=0.01
# Comma-separated extra blocklist (merged with built-in low-conviction list)
# EXCLUDED_TOKENS=
# Binance Web3 OHLCV cache per token (default 15 min)
# OHLCV_CACHE_MS=900000
# Max slippage per swap (%). Default: 1
SLIPPAGE_TOLERANCE=1
# MAX_POSITION_SIZE_USD=250
# MIN_BUY_INTERVAL_MS=600000
# MAX_PORTFOLIO_TOKENS=4
# STOP_LOSS_PCT=8
# TAKE_PROFIT_PCT=15          # arm the trail (does not sell at this print)
# TRAILING_ACTIVATE_PCT=15    # optional; defaults to TAKE_PROFIT_PCT
# TRAILING_GIVEBACK_PCT=1     # sell after a 1% drop from the hold's peak price
# MIN_BUY_CONFIDENCE=0.55

# Autonomous SL + trailing-TP exits.
# Hitting TAKE_PROFIT_PCT arms a trail; the position is sold only after
# price drops TRAILING_GIVEBACK_PCT from the live peak (default 1%).
# PROTECTIVE_EXIT_CHECK_MS default 10s so the trail can follow price.
# AUTO_EXIT_ENABLED=true

# After a failed autonomous swap, wait before retrying the same token (default 30 min).
# FAILED_SWAP_COOLDOWN_MS=1800000

# Live week: set execution.dry_run false in config/competition.yaml or Agent → Prepare for live

# ── Production / Deployment ──
# REQUIRED for production: shared secret between agent API ↔ dashboard proxy.
# Generate with: openssl rand -hex 32.
# When set, GET endpoints stay public (monitoring) but all POST/mutating
# endpoints (start/stop/restart/command/config/wallet) require this secret.
# MUST be set on the public VPS so a read-only dashboard can't control the agent.
# API_SECRET=

# Node environment (set to "production" on VPS)
# NODE_ENV=production

# API CORS (comma-separated origins for custom dashboard host)
# CORS_ORIGINS=https://agents.clipx.app,http://localhost:3000

# Dashboard port (Next.js)
# DASHBOARD_NEXT_PORT=3000

# Agent API port (internal, proxied by Nginx)
# DASHBOARD_PORT=3847

# BRIDGE_MODE=auto          # auto | baw | cmc-pro | mock

# ── AI Assistant (OpenAI-compatible) ──
# Powers natural language commands in the dashboard assistant.
# Works with: OpenAI, DeepSeek, OpenRouter, or any OpenAI-compatible API.
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1          # default; change for other providers
# OPENAI_MODEL=gpt-4o-mini                           # any chat model the provider supports

# AI technical analysis on top trading signals (uses same OPENAI_* vars above)
# Set AI_SIGNAL_ANALYSIS=false to disable even when OPENAI_API_KEY is set
# AI_SIGNAL_ANALYSIS=true
# AI_SIGNAL_TOP_N=5                                  # max tokens analyzed per cycle

# BscScan / Etherscan API v2 key — optional per-transaction backfill (tx hash + BSCScan link).
# NOTE: free Etherscan keys no longer support BSC (chain 56); paid plan required.
# Recent Trades uses Binance Web3 aggregate stats by default (no key needed).
# Get key: https://etherscan.io/apidashboard
# BSCSCAN_API_KEY=

# ── Neon Postgres (long-term persistence) ──
# Get from: Neon console → Project → Connection string (CaptainX project)
# Stores trades, NAV snapshots, chain syncs, peak drawdown state.
# Optional — agent runs fine without it (in-memory only).
# DATABASE_URL=postgresql://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
