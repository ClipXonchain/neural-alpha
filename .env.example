# CoinMarketCap Pro API
# Get from: https://coinmarketcap.com/api/
CMC_PRO_API_KEY=
# Alias also accepted:
# CMC_API_KEY=

# ── Self-custodial agent wallet ──
# Master secret used to derive per-agent keystore unlock passwords (AES-256-GCM).
# Generate with: openssl rand -hex 32
WALLET_MASTER_SECRET=

# Optional: import an existing private key (dev only — FORBIDDEN in production)
# AGENT_PRIVATE_KEY=

# Optional: override keystore path (default: data/agents/{AGENT_ID}/keystore.json)
# AGENT_KEYSTORE_PATH=
# AGENT_DATA_DIR=./data/agents

# BSC RPC endpoint
# BSC_RPC_URL=https://bsc-dataseed.binance.org

# Binance Web3 Trading API (DEX aggregator) — required for live swaps
# Create keys in the Binance Web3 / OnchainOS developer portal
# Docs: https://web3.binance.com/en/dev-docs/catalog/web3-wallet/api/rest-api/trading-api
BINANCE_WEB3_API_KEY=
BINANCE_WEB3_API_SECRET=
# Optional override (default: https://web3.binance.com/build)
# BINANCE_WEB3_TRADING_BASE_URL=https://web3.binance.com/build
# Reject aggregator routes with price impact above this % (default 5)
# MAX_PRICE_IMPACT_PCT=5

# Live BSC execution via self-custodial wallet (paper mode removed)
BRIDGE_MODE=evm

# Agent wallet address — usually auto-set after keystore unlock
# AGENT_WALLET_ADDRESS=0x...
AGENT_NAV_USD=1000

# Default swap source tokens for buys (USDT first). Sells settle to BASE_CURRENCY.
# SWAP_CURRENCIES=USDT
# BASE_CURRENCY=USDT
# MIN_GAS_RESERVE_USD=1.5
# BSC_GAS_PRICE_GWEI=0.07
# BSC_SWAP_GAS_LIMIT=0
# Gas speed: Cheapest 0.07 · Low 0.10 · Normal 0.15 (limit always auto / 0)
# BSC_SWAP_GAS_LIMIT=0
# MIN_POSITION_VALUE_USD=1

DEFAULT_FROM_SYMBOL=USDT

# Cycle interval in ms — full scan + autonomous buys (live default: 3600000 = 1h)
# TRADE_INTERVAL_MS=900000

# SL/TP/trailing check interval — sells only (default 60s)
# PROTECTIVE_EXIT_CHECK_MS=60000

# MIN_TRADE_AMOUNT_USD=5

# ── Strategy preset (risk tier) ──
# safe | medium | momentum
# STRATEGY=medium

# MAX_DRAWDOWN_PCT=20
# DISABLE_DRAWDOWN_LIMIT=true   # NEVER enable in production — disables risk pause
SIGNAL_REFRESH_MS=300000
# Shared market feed — one CMC/Binance/ClipX poll for all agents (saves API quota)
# Start with: npm run market-feed
# MARKET_FEED_URL=http://127.0.0.1:4100
# MARKET_FEED_PORT=4100
# BINANCE_ALPHA_CACHE_MS=21600000
# MIN_TRADABLE_PRICE_USD=0.01
# MAX_TRADABLE_MARKET_CAP_USD=10000000000
# AGENT_UNIVERSE=both   # spot | alpha | both | bstocks
# EXCLUDED_TOKENS=
# OHLCV_CACHE_MS=900000
MAX_DAILY_TRADES=10
SLIPPAGE_TOLERANCE=1
# MIN_GAS_RESERVE_USD=1.5
# BSC_GAS_PRICE_GWEI=0.07
# BSC_SWAP_GAS_LIMIT=0
# Gas speed: Cheapest 0.07 · Low 0.10 · Normal 0.15 (limit always auto / 0)
# BSC_SWAP_GAS_LIMIT=0
# MAX_PORTFOLIO_TOKENS=4
# STOP_LOSS_PCT=8
# TAKE_PROFIT_PCT=15
# TRAILING_ACTIVATE_PCT=6
# TRAILING_GIVEBACK_PCT=3
# MIN_BUY_CONFIDENCE=0.55

# STARTUP_TRADE_COOLDOWN_MS=120000
# AUTO_EXIT_ENABLED=false
# FAILED_SWAP_COOLDOWN_MS=1800000
# MAX_AUTONOMOUS_TRADES_PER_CYCLE=1
# MAX_ONCHAIN_TX_PER_DAY=10

# ── Production / Deployment ──
# Per-agent API secret (auto-derived on deploy; legacy: openssl rand -hex 32)
# API_SECRET=

# Dedicated session key (≥32 chars). Required in production — never reuse API_SECRET.
# SESSION_SECRET=

# Keystore master secret (≥32 chars). Required in production — must differ from API_SECRET.
# WALLET_MASTER_SECRET=

# SIWE login domains (comma-separated host[:port], no https://)
# Example: localhost:3000,127.0.0.1:3000,agents.clipx.app
# SIWE_DOMAIN=your.domain.com

# Public read-only monitor (blocks proxy mutations + API secret injection)
# READONLY=true
# NEXT_PUBLIC_READONLY=true
# Optional: force read-only for these Host headers (comma-separated). Empty = off.
# PUBLIC_MONITOR_HOSTS=

# NODE_ENV=production
# Multi-tenant: skip PM2 singleton agent (dashboard spawns per-agent processes)
# AGENT_PROCESS_MANAGER=pm2   # default when pm2 is on PATH; use "spawn" only for local debug
# DISABLE_SINGLETON_AGENT=true
# CORS_ORIGINS=https://agents.clipx.app,http://localhost:3000
# DASHBOARD_NEXT_PORT=3000
# DASHBOARD_PORT=3847

# AGENT_DISPLAY_NAME=My Trading Agent
# PUBLIC_BASE_URL=https://your-dashboard.example.com

# ── AI Assistant (OpenAI-compatible) ──
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# AI_SIGNAL_ANALYSIS=true
# AI_SIGNAL_TOP_N=5

# BSCSCAN_API_KEY=

# ── Neon Postgres ──
# DATABASE_URL=postgresql://user:pass@ep-xxx.aws.neon.tech/neondb?sslmode=require

# ── Platform (multi-tenant) ──
# PLATFORM_TREASURY_ADDRESS=0x...
# DEPLOY_FEE_BNB=0.01
# SIWE_DOMAIN=localhost:3000,127.0.0.1:3000
# NEXTAUTH_SECRET=  # or SESSION_SECRET

# WalletConnect (Reown) — free project id from https://cloud.walletconnect.com
# Must be NEXT_PUBLIC_ so the browser can open the QR modal
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
