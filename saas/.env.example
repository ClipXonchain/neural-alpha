# Per-tenant file, mounted at /data/tenant.env.
# The worker copies it into the upstream tree at start because that
# process loads .env with override. Do not commit real values.

AGENT_MODE=paper
PAYMENT_TOKEN=USDT
BRIDGE_MODE=auto
DASHBOARD_PORT=3847
SQLITE_PATH=/data/book/neural-alpha.sqlite
EXTERNAL_FLOWS_FILE=/data/book/external-flows.json

# Alerts and backups (see OPERATIONS.md). All optional.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=
# TELEGRAM_BOT_POLL=1            # on exactly one process (the mother)
# TELEGRAM_OPS_CHAT_ID=
# SAAS_BACKUP_KEY=               # 64 hex characters; keep a copy off this server
# SAAS_BACKUP_DIR=
# SAAS_BACKUP_RSYNC=user@host:/path
