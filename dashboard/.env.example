# Agent API URL — in production, agent runs on the same box at localhost.
# The Next.js server-side proxy uses this to reach the agent API.
# AGENT_API_URL=http://127.0.0.1:3847

# Shared secret between dashboard and agent API. Must match API_SECRET in root .env.
# The Next.js proxy attaches this as a Bearer token when forwarding to the agent.
# API_SECRET=

# SSE uses the Next.js proxy at /api/agent/events by default (no direct port needed).
# Do NOT set NEXT_PUBLIC_AGENT_SSE_URL — it bypasses the proxy and auth layer.
