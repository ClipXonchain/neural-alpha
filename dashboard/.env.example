# Agent API URL — in production, agent runs on the same box at localhost.
# The Next.js server-side proxy uses this to reach the agent API.
# AGENT_API_URL=http://127.0.0.1:3847

# Shared secret between dashboard and agent API. Must match API_SECRET in root .env.
# The Next.js proxy attaches this as a Bearer token when forwarding to the agent.
# API_SECRET=

# SSE uses the Next.js proxy at /api/agent/events by default (no direct port needed).
# Do NOT set NEXT_PUBLIC_AGENT_SSE_URL — it bypasses the proxy and auth layer.

# ── Public / read-only deployment (e.g. agents.clipx.app) ───────────────────
# Set BOTH of these on the public build to make the dashboard monitoring-only:
#   - NEXT_PUBLIC_READONLY hides all control UI (start/stop, command/assistant,
#     wallet sync, register, resync, config) — inlined into the client bundle.
#   - READONLY stops the server-side proxy from auto-attaching API_SECRET, so
#     anonymous visitors can read (GET) but cannot mutate (POST).
# Leave BOTH unset on the local/operator build so controls work.
# NEXT_PUBLIC_READONLY=true
# READONLY=true
